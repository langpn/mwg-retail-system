<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="MWG-Retail-System-Architect" version="24.7.17" type="device">
  <diagram id="tab-usecase" name="01 - Use Case Diagram">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uc_title" value="&lt;b&gt;BIỂU ĐỒ USE CASE TỔNG QUÁT — HỆ THỐNG BÁN LẺ ĐA CHI NHÁNH ĐIỆN MÁY XANH&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#475569;'&gt;Môn học: Công cụ Web và Website hướng dữ liệu (IUH — Lớp DHCNTT21BVL)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_sys" value="HỆ THỐNG QUẢN LÝ DỮ LIỆU &amp;amp; BÁN LẺ ĐA CHI NHÁNH MWG" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f3d6e;fontStyle=1;fontSize=14;rounded=1;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="920" height="760" as="geometry" />
        </mxCell>
        <mxCell id="act_cust" value="&lt;b&gt;Khách hàng&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569;'&gt;(Customer)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="105" y="310" width="55" height="105" as="geometry" />
        </mxCell>
        <mxCell id="act_admin" value="&lt;b&gt;Quản trị viên Siêu thị&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#475569;'&gt;(Store Admin)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1315" y="430" width="55" height="105" as="geometry" />
        </mxCell>
        <mxCell id="uc1" value="UC-01: Tra cứu &amp;amp; Lọc sản phẩm đa chiều&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Danh mục, Hãng, Giá trần, Từ khóa)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="70" y="65" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="UC-02: Xem chi tiết SP &amp;amp; Tồn kho chi nhánh&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Kiểm tra số lượng tại Q.9 / Thủ Đức)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="70" y="165" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="UC-03: Đăng ký &amp;amp; Đăng nhập bằng SĐT&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Đồng bộ bảng customers)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="70" y="265" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="UC-04: Quản lý Giỏ hàng &amp;amp; Đặt mua hàng&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Giao dịch @Transactional)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="70" y="370" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="UC-05: Gửi đánh giá sản phẩm (1–5 sao)&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Bình luận &amp;amp; điểm xếp hạng)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="70" y="480" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="uc4_inc" value="Kiểm tra &amp;amp; Tự động khấu trừ&lt;br&gt;tồn kho chi nhánh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;dashed=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="560" y="315" width="290" height="68" as="geometry" />
        </mxCell>
        <mxCell id="uc4_ext" value="Áp dụng mã khuyến mãi&lt;br&gt;(Voucher MWG5 / TET2027)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;dashed=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="560" y="425" width="290" height="68" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="UC-06: Điều chỉnh tồn kho &amp;amp; Duyệt đơn hàng&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(HTTP PUT cập nhật kho &amp;amp; trạng thái đơn)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontColor=#3b0764;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="480" y="545" width="370" height="74" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="UC-07: Quản trị CRUD toàn diện 6 phân hệ&lt;br&gt;&lt;font style='font-weight:normal;font-size:11px;'&gt;(Sản phẩm, Khách hàng, Khuyến mãi, Đánh giá)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontColor=#3b0764;fontSize=12.5;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="uc_sys">
          <mxGeometry x="480" y="645" width="370" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e_c_1" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_cust" target="uc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_2" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_cust" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_3" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_cust" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_4" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_cust" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_c_5" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_cust" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_1" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_admin" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_2" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_admin" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_3" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="act_admin" target="uc7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_inc" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#b45309;strokeWidth=1.5;fontColor=#92400e;fontStyle=2;fontSize=11;" edge="1" parent="1" source="uc4" target="uc4_inc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ext" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#b45309;strokeWidth=1.5;fontColor=#92400e;fontStyle=2;fontSize=11;" edge="1" parent="1" source="uc4_ext" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab-arch" name="02 - System Architecture (4-Tier)">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ar_title" value="&lt;b&gt;KIẾN TRÚC KỸ THUẬT 4 TẦNG — HYBRID SPRING MVC + RESTFUL API + REACT SPA (:8088)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#475569;'&gt;Phân tách chuẩn mực Presentation — Controller — Service — Repository/JPA — MySQL 8.0&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="210" y="15" width="1100" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ar_browser" value="&lt;b&gt;Trình duyệt Web (Khách hàng &amp;amp; Admin)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Truy cập đồng nhất cổng http://localhost:8088 (Tải trang &amp;lt; 20ms)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontSize=12.5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="880" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ar_postman" value="&lt;b&gt;Postman API Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Kiểm thử độc lập 29+ REST Endpoints (JSON)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12.5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="140" y="80" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="tier1" value="TẦNG 1: TRÌNH DIỄN &amp;amp; ĐỊNH TUYẾN TĨNH (PRESENTATION LAYER — PORT 8088)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0c4a6e;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="175" width="1240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="t1_spa" value="&lt;b&gt;React 19 + Next.js 16 Static SPA&lt;/b&gt; (&lt;code&gt;classpath:/static/&lt;/code&gt;)&lt;br&gt;&lt;font style='font-size:11px;'&gt;Routes: &lt;code&gt;/&lt;/code&gt;, &lt;code&gt;/product/[sku]&lt;/code&gt;, &lt;code&gt;/cart&lt;/code&gt;, &lt;code&gt;/checkout&lt;/code&gt;, &lt;code&gt;/auth&lt;/code&gt;, &lt;code&gt;/dashboard&lt;/code&gt;&lt;br&gt;Gọi Fetch API bằng đường dẫn tương đối &lt;code&gt;/api/v1/...&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;" vertex="1" parent="tier1">
          <mxGeometry x="25" y="44" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="t1_filter" value="&lt;b&gt;StaticPageRoutingFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Forward clean URL (&lt;code&gt;/cart&lt;/code&gt; → &lt;code&gt;/cart.html&lt;/code&gt;)&lt;br&gt;Bỏ qua &lt;code&gt;/api/**&lt;/code&gt; &amp;amp; &lt;code&gt;/mvc/**&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=11.5;" vertex="1" parent="tier1">
          <mxGeometry x="545" y="44" width="290" height="76" as="geometry" />
        </mxCell>
        <mxCell id="t1_mvc" value="&lt;b&gt;Spring MVC + Thymeleaf View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;&lt;code&gt;templates/mvc-catalog.html&lt;/code&gt;&lt;br&gt;SSR nạp sẵn Combobox (&amp;lt;15ms) + JS Fetch CRUD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11.5;" vertex="1" parent="tier1">
          <mxGeometry x="855" y="44" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="tier2" value="TẦNG 2: ĐIỀU KHIỂN (CONTROLLER LAYER — com.example.demojpa.controller)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="350" width="1240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t2_rest" value="&lt;b&gt;6 Lớp @RestController (RESTful Web Services — Jackson tự động chuyển đổi JSON)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;&lt;code&gt;ProductApiController&lt;/code&gt; • &lt;code&gt;InventoryApiController&lt;/code&gt; • &lt;code&gt;OrderApiController&lt;/code&gt; • &lt;code&gt;CustomerApiController&lt;/code&gt; • &lt;code&gt;PromotionApiController&lt;/code&gt; • &lt;code&gt;ProductReviewApiController&lt;/code&gt;&lt;br&gt;Đầy đủ 4 HTTP Verbs: &lt;b&gt;GET, POST, PUT, DELETE&lt;/b&gt; (&lt;code&gt;@PathVariable&lt;/code&gt;, &lt;code&gt;@RequestParam&lt;/code&gt;, &lt;code&gt;@RequestBody&lt;/code&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=12;" vertex="1" parent="tier2">
          <mxGeometry x="25" y="42" width="810" height="74" as="geometry" />
        </mxCell>
        <mxCell id="t2_mvc" value="&lt;b&gt;1 Lớp @Controller (MVC)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;&lt;code&gt;MvcCatalogController&lt;/code&gt;&lt;br&gt;&lt;code&gt;GET /mvc/catalog&lt;/code&gt; → đẩy &lt;code&gt;Model&lt;/code&gt; sang View&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#3b0764;fontSize=12;" vertex="1" parent="tier2">
          <mxGeometry x="855" y="42" width="360" height="74" as="geometry" />
        </mxCell>
        <mxCell id="tier3" value="TẦNG 3: NGHIỆP VỤ &amp;amp; GIAO DỊCH (SERVICE LAYER — com.example.demojpa.service &amp;amp; dto)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="520" width="1240" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sv1" value="&lt;b&gt;ProductCatalogService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Lọc đa tiêu chí &amp;amp; CRUD SP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="25" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sv2" value="&lt;b&gt;InventoryService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Tra cứu &amp;amp; cập nhật tồn kho&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="225" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sv3" value="&lt;b&gt;OrderService (@Tx)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Tính voucher &amp;amp; trừ tồn kho&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="425" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sv4" value="&lt;b&gt;CustomerService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Đăng ký/Tra cứu SĐT KH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="625" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sv5" value="&lt;b&gt;PromotionService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Quản lý mã giảm giá&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="825" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="sv6" value="&lt;b&gt;ProductReviewService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px;'&gt;Đánh giá 1–5 sao&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=11.5;" vertex="1" parent="tier3">
          <mxGeometry x="1025" y="44" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="tier4" value="TẦNG 4: TÀNG THƯ DỮ LIỆU &amp;amp; ORM (PERSISTENCE LAYER — repository &amp;amp; entity)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="685" width="1240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t4_repo" value="&lt;b&gt;10 Interfaces extends JpaRepository&amp;lt;Entity, Long&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Tự sinh CRUD + Derived Queries (&lt;code&gt;findBySku&lt;/code&gt;, &lt;code&gt;findByPhone&lt;/code&gt;) + Truy vấn &lt;code&gt;@Query&lt;/code&gt; JPQL lọc đa điều kiện&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;" vertex="1" parent="tier4">
          <mxGeometry x="25" y="42" width="600" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t4_ent" value="&lt;b&gt;10 Lớp @Entity POJO (Hibernate ORM Code-First)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;&lt;code&gt;@Table&lt;/code&gt;, &lt;code&gt;@Id&lt;/code&gt;, &lt;code&gt;@GeneratedValue(IDENTITY)&lt;/code&gt;, &lt;code&gt;@ManyToOne&lt;/code&gt;, &lt;code&gt;@OneToMany(mappedBy)&lt;/code&gt;, &lt;code&gt;@JsonIgnore&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;" vertex="1" parent="tier4">
          <mxGeometry x="645" y="42" width="570" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ar_db" value="&lt;b&gt;MySQL 8.0 Server (:3306)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Schema: &lt;code&gt;mwg-retail-system&lt;/code&gt; (10 bảng quan hệ 3NF) • Dự phòng: H2 In-Memory (Profile &lt;code&gt;dev&lt;/code&gt;)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#0f3d6e;strokeColor=#082f49;fontColor=#ffffff;fontSize=12.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="845" width="660" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ea6" value="Constructor DI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0369a1;" edge="1" parent="1" source="tier2" target="tier3">
